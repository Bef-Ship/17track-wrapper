HTTP_ADDR=:8092
LOG_LEVEL=info
APP_ENV=local
# api | worker | all (unset: worker when run as tracking-worker, else api).
# Both roles need the DB / Redis / 17TRACK / archive settings below.
TRACKING_ROLE=

TRACKING_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracking?sslmode=disable&search_path=tracking,public
REDIS_URL=redis://127.0.0.1:6379/0

# Platform 17TRACK API token (real account). Empty is OK for nop-carrier-only local
# when ENABLE_MOCK=true (Selective routes key 900001 to the in-process Nop client).
TRACK17_SECRET=

# Append mock NOP carrier (key 900001) on GET /v1/carriers, and after register
# seed a TRACKING_UPDATED webhook with fake events (shipment callbacks included).
ENABLE_MOCK=true

# Asynq task type for publish/subscribe. Must match gateway EVENT_TASK_TYPE
# when consuming external.17track (gateway default: befship.event).
EVENT_TASK_TYPE=tracking.event

# Backend shipment projection callback (optional). With Redis the api role enqueues and
# the worker role delivers with retries, so set these on both.
SHIPMENT_CALLBACK_URL=http://127.0.0.1:50051/internal/shipment/tracking-update
SHIPMENT_CALLBACK_SECRET=

# Per-service tokens "name:token,..." for every route except /healthz, /readyz and
# /openapi.yaml. Callers send header "17token: <token>" or "Authorization: Bearer <token>".
# Required in production (APP_ENV=production); empty elsewhere = no auth.
# Each caller (backend / gateway) gets its own rotatable token.
TRACKING_SERVICE_TOKENS=backend:change-me,gateway:change-me-too

# SyncActive backstop: poll GetTrackInfo for TRACKING packages not heard for this many hours.
# 17TRACK does not charge quota for GetTrackInfo (only register does); keep sparse to save QPS.
SYNC_STALE_HOURS=48

# Inactive packages untouched this many days move to S3 (worker role).
# Direct S3-compatible API (RustFS / COS) — no obj-gateway hop.
ARCHIVE_ENABLED=false
ARCHIVE_RETENTION_DAYS=100
TRACKING_ARCHIVE_BUCKET=
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=

