# tracking-service environment example
# cp .env.example .env

# --- HTTP ---
HTTP_ADDR=:8092
LOG_LEVEL=info
# When set, /v1/* requires "Authorization: Bearer <key>" or "X-API-Key: <key>"
API_KEY=

# --- PostgreSQL (hot store) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracking?sslmode=disable

# --- Cold archive (S3-compatible: AWS S3 / Tencent COS / RustFS) ---
ARCHIVE_ENABLED=false
ARCHIVE_RETENTION_DAYS=90
ARCHIVE_BATCH_SIZE=200
# Daily HH:MM in ARCHIVE_TIMEZONE; "off" disables the in-process scheduler
ARCHIVE_SCHEDULE=03:00
ARCHIVE_TIMEZONE=Asia/Shanghai
# Required when ARCHIVE_ENABLED=true
S3_ENDPOINT=
S3_REGION=ap-shanghai
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- OLAP (ClickHouse / TCHouse-C) ---
OLAP_ENABLED=false
OLAP_DRIVER=clickhouse
# Required when OLAP_ENABLED=true
CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/default
CLICKHOUSE_TABLE=tracking_event_olap
CLICKHOUSE_ASYNC_INSERT=true
